{
  "name": "hefesto-visualizer",
  "displayName": "Hefesto C4 Architecture Visualizer",
  "description": "Botão na barra do editor para visualizar os Níveis 1–3 curados e gerar sob demanda o Nível 4 (Código via AST) no modelo C4.",
  "version": "1.1.0",
  "publisher": "hefesto",
  "repository": {
    "type": "git",
    "url": "https://github.com/supernova/hefesto"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "hefesto.openVisualizer",
        "title": "Hefesto C4: Abrir Arquitetura (Níveis 1 a 4)",
        "category": "Hefesto",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hefesto.openVisualizer",
          "group": "navigation",
          "when": "resourceExtname == .py"
        }
      ]
    },
    "markdown.previewScripts": [
      "./preview-fix.js"
    ]
  }
}
